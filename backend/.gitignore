# Backups locaux générés par cmd/migrate_receipts --execute (contiennent d'anciennes
# receipt_url — jamais commités).
migrate_receipts_backup_*.txt

# Identifiants de migration locaux (Migration Tooling Security Hardening) — .env.neon
# est déjà couvert par .env.* ci-dessous, listé ici explicitement par clarté.
.env.neon
migration.env

# ── Environnement ────────────────────────────────────────────────
# Ce bloc doit rester le DERNIER mot sur les fichiers .env* : aucune règle .env*
# ne doit apparaître après lui, sinon elle annulerait l'exception ci-dessous
# (les règles gitignore sont évaluées dans l'ordre du fichier, la dernière
# correspondance l'emporte).
.env
.env.*
!.env.example
