# MazadPay Backend — environment variable reference.
# Copy to .env for local development, or set these in your deployment platform
# (e.g. Render) environment settings. NEVER commit a real .env file — only this
# .env.example (no secret values) is tracked in git.

# ── Application ──────────────────────────────────────────────────
# APP_ENV controls both the CORS fallback (see CORS_ALLOWED_ORIGINS below) and
# whether DEV_OTP_CODE is honored. Use "development" locally, "production" for
# the live backend, or any other value (e.g. "staging") for a non-production
# deployment such as a Render Staging service — a non-"development" value never
# enables the DEV_OTP_CODE bypass and, unless CORS_ALLOWED_ORIGINS is set, falls
# back to the same origin allow-list as production.
APP_ENV=development
# APP_PORT is only a fallback: Render (and similar platforms) inject PORT
# automatically, which always takes priority when present.
APP_PORT=8082
APP_NAME=MazadPay

# ── PostgreSQL ───────────────────────────────────────────────────
# Required to boot. For a Neon branch (e.g. a Staging/Validation branch), copy
# the exact Host/Port/Database/User/Password shown in that branch's own
# "Connect" panel in the Neon Console — never reuse production's values.
DB_HOST=localhost
DB_PORT=5432
DB_USER=mazadpay
DB_PASSWORD=
DB_NAME=mazadpay
# Use "require" for Neon (or any TLS-only Postgres); "disable" is only valid for
# a local/Docker Postgres with no TLS.
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# ── Redis ────────────────────────────────────────────────────────
# Required to boot.
REDIS_URL=redis://localhost:6379/0
REDIS_OTP_TTL_MINUTES=5
REDIS_RATE_LIMIT_WINDOW_SECONDS=900
REDIS_RATE_LIMIT_MAX_ATTEMPTS=6

# ── JWT ──────────────────────────────────────────────────────────
# Required to boot (server refuses to start if empty). Use a long random value,
# generated fresh per environment — never reuse production's secret for
# Staging/Validation.
JWT_SECRET=
JWT_EXPIRY_HOURS=72
JWT_REFRESH_EXPIRY_DAYS=30

# ── CORS (CORS_ALLOWED_ORIGINS Phase 1) ─────────────────────────
# Optional. Comma-separated list of allowed CORS origins (scheme://host[:port]
# only — no path, query string, fragment, or "*"). Leave unset/empty to keep the
# built-in defaults (the production allow-list for any APP_ENV other than
# "development", or localhost for APP_ENV=development). Set this to give a
# non-production deployment (e.g. a Staging service) its own allowed origin(s)
# without ever touching the production defaults.
# Example (a Staging Admin dashboard origin):
# CORS_ALLOWED_ORIGINS=https://mazadpay-validation-admin.onrender.com
CORS_ALLOWED_ORIGINS=

# ── Cloudflare R2 / S3-compatible media storage (optional) ───────
# Leave these at their placeholder values (or empty) to disable R2 and fall back
# to local static file serving under /uploads — safe default for Staging, no
# external storage account needed.
R2_ENDPOINT=xxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_MEDIA=mazad-mwdia
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
# R2_BUCKET_RECEIPTS is intentionally empty by default — no silent fallback to
# the public media bucket for payment receipts.
R2_BUCKET_RECEIPTS=

# ── Wablas WhatsApp OTP (optional) ────────────────────────────────
# Leave both empty to disable real OTP sending — new accounts are then
# auto-verified without an OTP round-trip. Safe default for Staging/local dev;
# only needed to test the real WhatsApp delivery path.
WABLAS_TOKEN=
WABLAS_SECRET_KEY=
WABLAS_SERVER_URL=https://wablas.com

# ── Firebase Cloud Messaging / push notifications (optional) ─────
# Leave both empty to disable push notifications — the server logs a warning
# and continues without an FCM client, no crash.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Business rules (optional, has defaults) ───────────────────────
BID_MIN_INCREMENT=100
INSURANCE_DEFAULT_AMOUNT=500
PAYMENT_DEADLINE_HOURS=48

# ── Default super admin seed (optional) ───────────────────────────
# Leave BOTH empty to skip seeding a default super admin on boot (recommended
# whenever an admin account already exists, e.g. a Validation/Staging database
# restored from a branch that already has one). Only set both together, and
# never use a weak/known PIN (1234, 0000, 1111, 0001 are rejected outright).
DEFAULT_SUPER_ADMIN_PHONE=
DEFAULT_SUPER_ADMIN_PIN=

# ── Development-only OTP bypass (optional) ────────────────────────
# Only honored when APP_ENV=development. Ignored for any other APP_ENV value
# (including "staging" and "production") regardless of whether it's set.
DEV_OTP_CODE=
